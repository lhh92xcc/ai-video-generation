    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "flux1_vae.safetensors"}
  },
  "4": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": "__AI_VIDEO_SEED__", "control_after_generate": "fixed"}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "__AI_VIDEO_PROMPT__", "clip": ["2", 0]}
  },
  "6": {
    "class_type": "FluxGuidance",
    "inputs": {"conditioning": ["5", 0], "guidance": "__AI_VIDEO_IMAGE_GUIDANCE__"}
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {"width": "__AI_VIDEO_WIDTH__", "height": "__AI_VIDEO_HEIGHT__", "batch_size": 1}
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"}
  },
  "9": {
    "class_type": "BasicScheduler",
    "inputs": {"model": ["1", 0], "scheduler": "simple", "steps": "__AI_VIDEO_IMAGE_STEPS__", "denoise": 1.0}
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {"image": "__AI_VIDEO_IDENTITY_IMAGE__"}
  },
  "11": {
    "class_type": "PulidFluxModelLoader",
    "inputs": {"pulid_file": "pulid_flux_v0.9.1.safetensors"}
  },
  "12": {
    "class_type": "PulidFluxInsightFaceLoader",
    "inputs": {"provider": "CPU"}
  },
  "13": {
    "class_type": "PulidFluxEvaClipLoader",
    "inputs": {}
  },
  "14": {
    "class_type": "ApplyPulidFlux",
    "inputs": {
      "model": ["1", 0],
      "pulid_flux": ["11", 0],
      "eva_clip": ["13", 0],
      "face_analysis": ["12", 0],
      "image": ["10", 0],
      "weight": "__AI_VIDEO_IMAGE_IDENTITY_WEIGHT__",
      "start_at": 0.0,
      "end_at": 1.0,
      "fusion": "mean",
      "fusion_weight_max": 1.0,
      "fusion_weight_min": 0.0,
      "train_step": 1000,
      "use_gray": true
    }
  },
  "15": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["14", 0], "conditioning": ["6", 0]}
  },
  "16": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["4", 0],
      "guider": ["15", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["7", 0]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["16", 0], "vae": ["3", 0]}
  },
  "18": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "ai-video-flux-faceid", "images": ["17", 0]}
  }
